# TPB4K is intentionally disabled until source adapters pass live validation.
TPB4K_ENABLED=false
TPB4K_CATALOG_LIMIT=40
TPB4K_MIN_SEEDERS=3
TPB4K_REQUEST_TIMEOUT_MS=15000
TPB4K_METADATA_CACHE_TTL_MS=600000
TPB4K_METADATA_NEGATIVE_TTL_MS=120000
TPB4K_METADATA_CACHE_MAX_ENTRIES=500

# Metadata enrichment. Use rotated values in Render; never commit real keys.
TPDB_API_KEY=
TPDB_REST_API_URL=https://api.theporndb.net
STASHDB_API_KEY=
STASHDB_API_URL=https://stashdb.org/graphql

# TPB studio catalogs use UHD category 507, top-by-seeders sort 7.
# Optional comma-separated bare HTTPS origins; defaults to the original three-mirror chain.
TPB4K_TPB_MIRRORS=https://thehiddenbay.com,https://thepiratebay0.org,https://piratebay.live

# Native Phase 2C discovery uses fixed, audited public origins.
# Sukebei RSS remains configurable only as an operational mirror override.
TPB4K_SUKEBEI_RSS_URL=https://sukebei.nyaa.si/?page=rss
