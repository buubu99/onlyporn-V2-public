# MetaTube production requirements.
# Render production should enable strict MetaTube explicitly.
# TPB4K_METATUBE_PROXY_SECRET must contain at least 32 characters.
# Never commit the real secret value.
TPB4K_METATUBE_ENABLED=
TPB4K_METATUBE_STRICT=
TPB4K_METATUBE_PROXY_SECRET=

# Immutable media-session owner used by OVH generation-aware routing.
# Set this to the deployed Git commit (7-40 hexadecimal characters).
ONLYPORN_MEDIA_GENERATION=

# Diagnostic only: exact bytes returned by each /media response.
# Enabled by default in code while bandwidth is being investigated.
ONLYPORN_MEDIA_USAGE_LOGGING=true

# TPB4K remains feature-gated. Render production currently enables it explicitly.
TPB4K_ENABLED=false
TPB4K_CATALOG_LIMIT=40
TPB4K_MIN_SEEDERS=3
TPB4K_REQUEST_TIMEOUT_MS=15000
TPB4K_METADATA_CACHE_TTL_MS=600000
TPB4K_METADATA_NEGATIVE_TTL_MS=120000
TPB4K_METADATA_CACHE_MAX_ENTRIES=500

# Metadata providers. Use rotated values in Render; never commit real keys.
TPDB_API_KEY=
TPDB_REST_API_URL=https://api.theporndb.net
STASHDB_API_KEY=
STASHDB_API_URL=https://stashdb.org/graphql

# The 19 studio rows are metadata-first in alpha.13. These settings bound
# provider pagination and concurrent requests while overscanning enough records
# to refill a page after explicit-tag filtering.
TPB4K_METADATA_CATALOG_MAX_PAGES=3
TPB4K_METADATA_CATALOG_CONCURRENCY=4
TPB4K_METADATA_PROVIDER_CIRCUIT_TTL_MS=300000
ONLYPORN_FILTER_OVERSCAN_FACTOR=3

# Global explicit-label filter. It applies centrally to catalog/search results,
# metadata and streams. It uses supplied tags/categories and strong explicit
# title/description labels only; it never analyzes posters or infers attributes.
ONLYPORN_CONTENT_FILTER_ENABLED=true
ONLYPORN_FILTER_GAY=true
ONLYPORN_FILTER_INTERRACIAL=true
ONLYPORN_FILTER_UNKNOWN=false
ONLYPORN_FILTER_STRONG_TEXT=true
ONLYPORN_FILTER_EXCLUDED_TAGS=

# TPB/HiddenBay remains the Phase 3 torrent lookup source for a selected
# metadata scene. Alpha.13 catalogs do not use these torrent rows as artwork.
# Optional comma-separated bare HTTPS origins; defaults to the audited chain.
TPB4K_TPB_MIRRORS=https://thehiddenbay.com,https://thepiratebay0.org,https://piratebay.live

# Native Phase 2C discovery uses fixed audited public origins. Sukebei RSS is
# configurable only as an operational mirror override.
TPB4K_SUKEBEI_RSS_URL=https://sukebei.nyaa.si/?page=rss&c=0_0&f=0
TPB4K_SUKEBEI_ENRICHMENT_DEADLINE_MS=24000
TPB4K_SUKEBEI_CODE_LOOKUP_LIMIT=40
TPB4K_SUKEBEI_TITLE_LOOKUP_LIMIT=4

# Legacy torrent-poster enrichment remains available to non-metadata-first
# paths and regression tests. It is no longer the source of the 19 studio rows.
TPB4K_METADATA_ENRICHMENT_CONCURRENCY=10
TPB4K_METADATA_LOOKUP_TIMEOUT_MS=2500
TPB4K_METADATA_ENRICHMENT_DEADLINE_MS=16000
TPB4K_METADATA_POOL_SIZE=100
TPB4K_METADATA_POOL_ALIAS_LIMIT=2
TPB4K_METADATA_TARGETED_ALIAS_LIMIT=2
TPB4K_METADATA_POOL_CACHE_MAX_ENTRIES=100
TPB4K_METADATA_MATCH_THRESHOLD=72
TPB4K_POSTER_ASSET_BASE_URL=https://raw.githubusercontent.com/buubu99/onlyporn-V2-public/main/assets/tpb4k/studios

TPB4K_SUKEBEI_LOOKUP_CONCURRENCY=8
TPB4K_SUKEBEI_RSS_PAGES=4
TPB4K_SUKEBEI_DETAIL_IMAGE_LIMIT=20
